# Valheim Portal deployment configuration.
#
#   cp deploy/install.conf.example deploy/install.conf
#   sudo ./scripts/install-portal.sh install --config deploy/install.conf
#
# Values here are host facts and policy. The installer generates the CSRF secret
# and the agent token itself and never prints them. The one credential this file
# accepts is the optional Steam Web API key below; supply it through the
# environment instead if you would rather not store it here.
#
# Every value may also be supplied through the environment. Comments and blank
# lines are ignored; quotes around a value are stripped.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public HTTPS origin browsers use. It must match the certificate served by the
# terminating proxy, because the portal issues secure cookies and builds the
# valheim-profile-sync:// handoff URLs from it.
PORTAL_PUBLIC_BASE_URL=https://valheim.example.com

# Source range of the terminating proxy, as the portal sees it.
#
# This is the entire administrative trust boundary. Any request arriving from
# inside this range that carries a non-empty identity header is treated as a
# fully authenticated administrator. Use the proxy's exact address with a /32
# (or /128) prefix. The installer refuses ranges that cover the public internet
# or more than a small subnet.
#
# Two shapes work, and they are not equivalent:
#
# 1. Proxy inside the portal's compose network - set this to the proxy
#    container's own address. The network check is then real: only that
#    container can present an identity.
#
# 2. Proxy on the host, reaching a published port - Docker NATs every such
#    request to the bridge gateway, so the only value that matches is the
#    gateway itself, and then the check cannot fail and cannot tell the proxy
#    from any other process on the host. Preflight REFUSES this by default.
#    Installing that way is a deliberate choice, and the installer makes you
#    say so:
#
#      sudo ./scripts/install-portal.sh install --config deploy/install.conf \
#           --allow-bridge-gateway-proxy-cidr
#
#    The admin token is then the only barrier in front of administration, so
#    the proxy must set X-Portal-Admin-Token on the admin routes and blank it
#    everywhere else.
#
# The value below is a bridge gateway, and therefore needs the flag above.
# Recheck it after any docker network recreate: a stale range makes the portal
# ignore the identity header and refuse every admin request, which reads as a
# broken sign-in rather than a configuration fault.
PORTAL_TRUSTED_PROXY_CIDR=172.17.0.1/32

# Directory holding Valheim world data. The agent gets write access to exactly
# this tree and the portal mounts it read-only for map generation.
VALHEIM_WORLD_ROOT=/srv/valheim

# Checkout of the modified valheim-server-docker fork whose compose project the
# world operation scripts drive. It is a separate Apache-2.0 project and is not
# vendored here, so it must be cloned and named. Provisioning also reads its
# default.env for the PGID the container chowns its mounts to. There is no
# default: the scripts run `docker compose down` and `docker compose rm -v`
# against whatever project lives at this path.
VALHEIM_SERVER_DOCKER_DIR=/srv/valheim-server-docker

# Worlds the agent may control, comma separated. The agent refuses every world
# outside this list, so a world absent here cannot be started, stopped, backed
# up, or deleted through the portal. Keep it synchronized with reality and
# restart the agent after a change.
AGENT_ALLOWED_WORLDS=WorldOne,WorldTwo

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Directory holding the world operation scripts the agent executes. They ship
# in this repository as hostops/, which is the default, so leave this unset
# unless the scripts are installed somewhere else. An override must name a
# directory laid out like hostops/ -- the scripts, lib/common.sh, and a sibling
# tools/ directory -- because the scripts resolve their Python helpers from it.
# The installer verifies every script the agent can invoke is present and
# executable either way.
#AGENT_SCRIPT_DIR=/srv/valheim-portal/hostops

# Where the portal listens on the host. Keep this on loopback: the admin routes
# have no network protection of their own.
#PORTAL_BIND_ADDR=127.0.0.1
#PORTAL_BIND_PORT=18080

# Header carrying the verified administrator identity. The proxy must set this
# explicitly on every route it forwards, and blank it on public routes.
#PORTAL_AUTH_HEADER=X-Forwarded-User

# SteamID64s allowed to administer the portal, comma separated. These are
# portal operators: a signed-in Steam account on this list may reach /admin and
# perform every privileged action, audited as steam:<id>. Because the portal
# recognises them from their own session rather than from a proxy header, the
# Administration link is visible to them on the ordinary player pages.
#
# This is NOT the per-world in-game admin role. That role is the Valheim
# server's own adminlist.txt, it applies inside one world, and it confers no
# portal access whatsoever. The two lists are maintained separately and on
# purpose.
#
# Empty, which is the default, keeps administration exactly as it was: only a
# request from the trusted proxy carrying both the identity header and the
# admin token may administer. That path remains available either way as a
# break-glass route. With this list populated the proxy must stop challenging
# /admin with auth_basic, or an allowlisted operator is stopped before the
# portal ever sees them; see docs/installation.md.
#PORTAL_ADMIN_STEAM_IDS=76561198000000001,76561198000000002

# "Confirm this sign-in": the player retypes a code only Valheim Profile Sync shows,
# so a stranger's browser session cannot authorize somebody else's desktop app.
# Set false ONLY on a single-operator install -- one person, their own proxy, their
# own machine -- where there is no second party to check and the step is a login tax
# on the only user. Any value other than exactly "false" keeps it on.
#PORTAL_REQUIRE_DEVICE_CODE=true

# Let a local agent process drive the portal. With this off, /api/agent/* answers
# 503 and the operator's agent page says the bridge is disabled -- which is the
# right default for a portal that can stop servers and delete worlds.
#
# Turning it on installs a token at /etc/valheim-portal/agent-bridge-token (mode
# 0640, group valheim-agent) and mounts it into the container. The agent process
# presents it as 'Authorization: Bearer <token>'; nothing else can reach those
# routes, and the operator still approves every mutating verb by hand.
#
# The token is generated whether or not this is true, so enabling it later is this
# one line plus a reinstall. Must be exactly true or false: the installer refuses
# anything else rather than reading it as off, because a bridge that is quietly
# disabled is indistinguishable from an agent that cannot connect.
#PORTAL_ENABLE_AGENT_BRIDGE=false

# The runner is the process that reads the operator conversation and asks a model
# what to do. Enabling the bridge installs it two ways, and you can use either
# without reinstalling:
#
#   on demand (default)  sudo systemctl start valheim-agent-runner-once
#                        journalctl -u valheim-agent-runner-once -n 20 --no-pager
#
#   polling              AGENT_RUNNER_SERVICE=true below, then reinstall
#                        journalctl -u valheim-agent-runner -f
#
# Both read /etc/valheim-portal/agent-runner.env, so a hand-run pass is a rehearsal
# of what the poller does. On demand is the default because a poller holds a model
# session open against a portal nobody is watching. Setting this true with the
# bridge off is refused rather than installed: it would poll a 503.
#AGENT_RUNNER_SERVICE=false

# The account whose omp login the runner uses. It cannot be the agent account: omp
# keeps its credentials in a home directory and the agent has none. Defaults to
# whoever runs the installer, which is normally right.
#AGENT_RUNNER_USER=operator

# Absolute path to omp. A unit's PATH does not include a user's ~/.local/bin, so
# this is resolved as AGENT_RUNNER_USER at install time and recorded; set it only
# when omp lives somewhere that lookup will not find.
#AGENT_RUNNER_OMP=/home/operator/.local/bin/omp

# Model for omp to use. Empty means omp's own default.
#AGENT_RUNNER_MODEL=

# How often the poller reads the inbox. Ignored on demand.
#AGENT_RUNNER_POLL=3s

# Source-code link shown on the player-facing pages. This is the program's
# AGPL-3.0 section 13 offer: run modified code as a network service and you owe
# its users the corresponding source. The default names the upstream project,
# which is only truthful for an unmodified build; point it at your own
# repository if you carry local changes. Absolute http or https URL.
#PORTAL_SOURCE_URL=https://github.com/neuralyze/valheim-portal

# System account owning the agent process and the socket the portal joins.
#AGENT_USER=valheim-agent
#AGENT_GROUP=valheim-agent

# Supplementary groups for the agent, comma separated. 'docker' is required to
# manage server containers. Add the group owning the world files when that
# tree is not owned by the agent account itself.
#AGENT_EXTRA_GROUPS=docker

# Runtime directory holding the agent's Unix socket.
#PORTAL_AGENT_SOCKET_DIR=/run/valheim-portal-agent

# Steam Web API key, used only to show persona names beside Steam IDs in /admin.
# Empty resolves names from the public community profile XML endpoint and
# therefore only for public profiles; a key (free at
# https://steamcommunity.com/dev/apikey) is batched and resolves private
# profiles too. Authorization never uses it.
#PORTAL_STEAM_API_KEY=

# Defaults prefilled by the server-creation wizard. Validation bounds stay in
# code. Join host defaults to the public base URL's hostname.
#PORTAL_DEFAULT_JOIN_HOST=valheim.example.com
#PORTAL_DEFAULT_GAME_PORT=2456
#PORTAL_DEFAULT_PLAYER_LIMIT=10
#PORTAL_DEFAULT_BACKUP_INTERVAL=1h
#PORTAL_DEFAULT_BACKUP_AGE_DAYS=7
#PORTAL_DEFAULT_BACKUP_COUNT=168
