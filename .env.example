# ---------------------------------------------------------------------------
# Installing with scripts/install-portal.sh? Then you do NOT edit this file.
# Edit deploy/install.conf instead: the installer generates this file and the
# agent's file from it. This example exists for running compose by hand.
#
# TWO FILES ARE DESCRIBED BELOW. Everything above the "Host agent" banner is
# read by compose, which is this .env. Everything below the banner belongs to a
# DIFFERENT file, /etc/valheim-portal/agent.env, and compose ignores it. That
# is why one directory appears twice under two names.
# ---------------------------------------------------------------------------

# Public portal container
PORTAL_BIND_PORT=18080
PORTAL_PUBLIC_BASE_URL=https://valheim.example.com
# Steam OpenID authentication uses this exact HTTPS origin for its callback.
# Add a player to a world from /admin after their first successful Steam login.
PORTAL_AUTH_HEADER=X-Forwarded-User
# Address of the reverse proxy as the portal container sees it, never the
# Docker bridge gateway. Under published-port NAT every request arrives from
# the gateway, so trusting it trusts every container and every process on the
# host; the installer refuses that value. Attach the proxy to the portal's
# compose network and use its container address, as below.
PORTAL_TRUSTED_PROXY_CIDR=172.20.0.2/32
# Read by deploy/Caddyfile, not by the portal: the forward-auth endpoint Caddy
# calls to authenticate an operator before it injects the two admin headers.
PORTAL_AUTHENTICATOR_URL=https://identity.example.invalid/verify
PORTAL_AGENT_SOCKET_DIR=/run/valheim-portal-agent
PORTAL_CSRF_SECRET_FILE=/etc/valheim-portal/csrf-secret
PORTAL_AGENT_TOKEN_FILE=/etc/valheim-portal/agent-token
# Shared secret the proxy must send as X-Portal-Admin-Token on every admin
# route. The portal refuses to start without it, and refuses admin requests
# that do not carry it, so the identity header alone can never grant access.
# scripts/install-portal.sh generates this file.
PORTAL_ADMIN_TOKEN_FILE=/etc/valheim-portal/admin-token
# compose.yaml refuses to start without these two as well, so the file stays
# complete: 'docker compose --env-file .env.example config' validates as is.
# Host directory holding Valheim world data, mounted read-only.
VALHEIM_WORLD_ROOT=/srv/valheim
# GID of the group owning the agent socket. The container joins it to reach
# the agent; scripts/install-portal.sh resolves the real value.
PORTAL_AGENT_GID=997

# Optional Steam Web API key used to label Steam IDs with persona names.
# Empty: names come from the public community profile XML endpoint, so only
# accounts with a public Steam profile resolve. Set: the official Steam Web API
# is used instead, batched and able to resolve private profiles too. Get a key
# free at https://steamcommunity.com/dev/apikey. Treat it as a credential: keep
# it out of version control.
PORTAL_STEAM_API_KEY=

# Defaults prefilled by the server-creation wizard. Validation bounds remain in code.
PORTAL_DEFAULT_JOIN_HOST=valheim.example.com
PORTAL_DEFAULT_GAME_PORT=2456
PORTAL_DEFAULT_PLAYER_LIMIT=10
PORTAL_DEFAULT_BACKUP_INTERVAL=1h
PORTAL_DEFAULT_BACKUP_AGE_DAYS=7
PORTAL_DEFAULT_BACKUP_COUNT=168

# ===========================================================================
# Host agent settings. These do NOT belong in this file on a real deployment.
# They live in /etc/valheim-portal/agent.env, which scripts/install-portal.sh
# writes. Compose reads only AGENT_SOCKET and AGENT_TOKEN_FILE from here; the
# rest are listed so you can see the complete picture in one place.
# ===========================================================================
AGENT_SOCKET=/run/valheim-portal-agent/agent.sock
AGENT_TOKEN_FILE=/etc/valheim-portal/agent-token
# Directory holding the world operation scripts. It ships in this repository as
# hostops/; install-portal.sh defaults to it and an override must name a
# hostops directory with a sibling tools/ directory.
AGENT_SCRIPT_DIR=/srv/valheim-portal/hostops
# The same directory as VALHEIM_WORLD_ROOT above, under the name the agent
# process reads. Set it once in deploy/install.conf as VALHEIM_WORLD_ROOT and
# the installer writes both. The hostops scripts call it VALHEIM_ROOT and
# accept any of the three, so you never set more than one.
AGENT_WORLD_ROOT=/srv/valheim
# Checkout of the modified valheim-server-docker fork. It is a separate
# Apache-2.0 project and is not vendored here; every lifecycle script drives
# its compose project and provisioning reads its default.env for the container
# PGID. There is no default: the scripts run `docker compose down` and `rm -v`
# against whatever project lives here.
VALHEIM_SERVER_DOCKER_DIR=/srv/valheim-server-docker
AGENT_ALLOWED_WORLDS=WorldOne,WorldTwo
# Keep this explicit allowlist synchronized with the worlds the agent may control. The admin page discovers only these directories and registers them disabled.
